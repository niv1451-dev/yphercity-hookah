      <fClutchChangeRateScaleDownShift value="2.500000" />
      <fInitialDriveMaxFlatVel value="55.000000" />
      <fBrakeForce value="1.100000" />
      <fBrakeBiasFront value="0.600000" />
      <fHandBrakeForce value="1.200000" />
      <fSteeringLock value="45.000000" />
      <fTractionCurveMax value="2.000000" />
      <fTractionCurveMin value="1.850000" />
      <fTractionCurveLateral value="22.000000" />
