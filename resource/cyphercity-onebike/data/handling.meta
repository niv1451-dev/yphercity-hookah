<?xml version="1.0" encoding="UTF-8"?>
<!-- One Bike: a throttle e-bike (no pedalling). Built on GTA's electric motorbike (POWERSURGE) with e-bike numbers:
     light, about 50 km/h top speed, quick but gentle pull, soft fat-tyre suspension, calm leaning. -->
<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>ONEBIKE</handlingName>
      <fMass value="110.000000" />
      <fInitialDragCoeff value="18.000000" />
      <fPercentSubmerged value="95.000000" />
      <vecCentreOfMassOffset x="0.000000" y="0.000000" z="0.000000" />
